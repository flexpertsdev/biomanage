# Site URL (for production)
PUBLIC_SITE_URL=https://biomanage.eu

# Google Analytics (optional)
PUBLIC_GA_TRACKING_ID=

# Contact Form Endpoint (optional - for form submissions)
PUBLIC_FORM_ENDPOINT=

