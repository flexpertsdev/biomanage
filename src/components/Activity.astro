---
interface Props {
  id?: string;
}

const { id = 'activity' } = Astro.props;

const activities = [
  {
    title: 'БИО МЕНИДЖ',
    subtitle: 'Европейски проекти',
    description: 'Със своята широка мрежа от партньорства в Европа "Био Менидж" съдейства за разработването и изпълнението на проекти с безвъзмездно финансиране (грант) на ЕС. В научно-изследователската и развойна дейност ще бъдат включени най-иновативните предприятия и институти, с които да обмените опит и разработите иновативни технологични решения.',
    image: '/images/activity-1.jpg',
    icon: 'project'
  },
  {
    title: 'ХОРИЗОНТ 2020',
    subtitle: 'Директно финансиране',
    description: 'В проектната ни дейност се целим в процедури управлявани пряко от ЕС (програми "Еврика" и "Хоризонт 2020") и заобикаляме тежките административни процедури и забавяния при грантови инструменти, администрирани от българските институции и държавни звена.',
    image: '/images/activity-2.jpg',
    icon: 'funding'
  }
];
---

<section id={id} class="py-20 bg-gradient-to-br from-primary-900 via-primary-800 to-green-900 text-white">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-white mb-4">
        Международна дейност
      </h2>
      <div class="w-24 h-1 bg-gradient-to-r from-green-400 to-primary-400 mx-auto mb-6"></div>
      <p class="text-lg text-gray-100 max-w-3xl mx-auto">
        Участваме активно в европейски проекти и програми за финансиране
      </p>
    </div>
    
    <!-- Activities -->
    <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
      {activities.map((activity, index) => (
        <div class={`group relative ${index === 0 ? 'md:pr-4' : 'md:pl-4'}`}>
          <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 hover:bg-white/15 transition-all duration-300">
            <!-- Icon -->
            <div class="w-16 h-16 bg-gradient-to-br from-green-400 to-primary-400 rounded-xl flex items-center justify-center mb-6">
              {activity.icon === 'project' ? (
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
              ) : (
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              )}
            </div>
            
            <!-- Content -->
            <h3 class="text-2xl font-bold text-white mb-2">
              {activity.title}
            </h3>
            <h4 class="text-lg font-medium text-green-300 mb-4">
              {activity.subtitle}
            </h4>
            <p class="text-gray-200 leading-relaxed">
              {activity.description}
            </p>
            
            <!-- Decorative quote -->
            <div class="absolute top-4 right-4 opacity-10">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Key Programs -->
    <div class="mt-16">
      <h3 class="text-xl font-semibold text-center mb-8 text-gray-100">
        Програми, в които участваме
      </h3>
      <div class="flex flex-wrap justify-center gap-4">
        <span class="px-6 py-3 bg-white/10 backdrop-blur-sm rounded-full text-white font-medium hover:bg-white/20 transition-colors">
          Хоризонт 2020
        </span>
        <span class="px-6 py-3 bg-white/10 backdrop-blur-sm rounded-full text-white font-medium hover:bg-white/20 transition-colors">
          Еврика
        </span>
        <span class="px-6 py-3 bg-white/10 backdrop-blur-sm rounded-full text-white font-medium hover:bg-white/20 transition-colors">
          LIFE Programme
        </span>
        <span class="px-6 py-3 bg-white/10 backdrop-blur-sm rounded-full text-white font-medium hover:bg-white/20 transition-colors">
          Interreg
        </span>
      </div>
    </div>
    
    <!-- Statistics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-16">
      <div class="text-center">
        <div class="text-3xl md:text-4xl font-bold text-green-300 mb-2">15+</div>
        <div class="text-sm text-gray-200">Реализирани проекта</div>
      </div>
      <div class="text-center">
        <div class="text-3xl md:text-4xl font-bold text-green-300 mb-2">7</div>
        <div class="text-sm text-gray-200">Държави партньори</div>
      </div>
      <div class="text-center">
        <div class="text-3xl md:text-4xl font-bold text-green-300 mb-2">€2M+</div>
        <div class="text-sm text-gray-200">Привлечено финансиране</div>
      </div>
      <div class="text-center">
        <div class="text-3xl md:text-4xl font-bold text-green-300 mb-2">25+</div>
        <div class="text-sm text-gray-200">Институции партньори</div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Add subtle animation to statistics on scroll */
  @keyframes countUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-count {
    animation: countUp 0.8s ease-out forwards;
  }
</style>
