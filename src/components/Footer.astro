---
import site from '../data/site.json';

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white mt-20">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Company Info -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3 mb-4">
          <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <h3 class="text-lg font-semibold">Адрес</h3>
        </div>
        <address class="not-italic text-gray-300 space-y-1">
          <p>{site.contact.address.street}</p>
          <p>{site.contact.address.city}, {site.contact.address.country}</p>
        </address>
      </div>
      
      <!-- Contact Info -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3 mb-4">
          <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <h3 class="text-lg font-semibold">Имейл</h3>
        </div>
        <a 
          href={`mailto:${site.contact.email}`}
          class="text-gray-300 hover:text-primary-400 transition-colors block"
        >
          {site.contact.email}
        </a>
      </div>
      
      <!-- Phone -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3 mb-4">
          <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <h3 class="text-lg font-semibold">Телефон</h3>
        </div>
        <a 
          href={`tel:${site.contact.phone.replace(/\s/g, '')}`}
          class="text-gray-300 hover:text-primary-400 transition-colors block"
        >
          {site.contact.phone}
        </a>
      </div>
    </div>
    
    <!-- Divider -->
    <div class="border-t border-gray-800 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
        <!-- Copyright -->
        <p class="text-gray-400 text-sm text-center md:text-left">
          © {currentYear} {site.name}. Всички права запазени.
        </p>
        
        <!-- Quick Links -->
        <nav aria-label="Бързи връзки">
          <ul class="flex flex-wrap justify-center gap-6 text-sm">
            {site.navigation.map((item) => (
              <li>
                <a 
                  href={item.href}
                  class="text-gray-400 hover:text-primary-400 transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    position: relative;
    overflow: hidden;
  }
  
  footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #22c55e 0%, #16a34a 50%, #22c55e 100%);
    background-size: 200% 100%;
    animation: gradient 3s ease infinite;
  }
  
  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
</style>
